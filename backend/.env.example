# === Claude API ===
# Pegue em https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
# Modelo usado (mude se quiser mais barato/rápido)
ANTHROPIC_MODEL=claude-sonnet-4-5

# === Firebase Admin (backend) ===
# Caminho para o JSON da service account do Firebase.
# Firebase Console -> Configurações do projeto -> Contas de serviço -> Gerar nova chave privada
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ID do projeto Firebase (mesmo do site de agenda consolidada, se for reaproveitar)
FIREBASE_PROJECT_ID=seu-projeto-firebase

# === Flask ===
FLASK_SECRET=troque-por-um-valor-aleatorio
PORT=5000
