# === Google Gemini ===
# Pegue em https://aistudio.google.com/app/apikey (Google AI Studio)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo usado. Veja os disponíveis para sua chave em /models
GEMINI_MODEL=gemini-2.5-flash

# === Firebase Admin (backend) ===
# Caminho para o JSON da service account do Firebase.
# Firebase Console -> Configurações do projeto -> Contas de serviço -> Gerar nova chave privada
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ID do projeto Firebase (mesmo do site de agenda consolidada)
FIREBASE_PROJECT_ID=calendar-190c7

# === Telegram (lembretes de refeição) ===
# Crie um bot com o @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Segredo que protege o endpoint /cron/send-reminders (invente um valor aleatório)
CRON_SECRET=um-segredo-aleatorio
# Fuso usado para comparar os horários das refeições
TIMEZONE=America/Sao_Paulo
# Janela em minutos (manda a refeição se o horário caiu nos últimos N min)
REMINDER_WINDOW_MIN=15

# === Flask ===
FLASK_SECRET=troque-por-um-valor-aleatorio
PORT=5000
