# === Google Gemini ===
# Pegue em https://aistudio.google.com/app/apikey (Google AI Studio)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo usado (gemini-1.5-flash é rápido e tem tier gratuito)
GEMINI_MODEL=gemini-1.5-flash

# === Firebase Admin (backend) ===
# Caminho para o JSON da service account do Firebase.
# Firebase Console -> Configurações do projeto -> Contas de serviço -> Gerar nova chave privada
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ID do projeto Firebase (mesmo do site de agenda consolidada)
FIREBASE_PROJECT_ID=calendar-190c7

# === Flask ===
FLASK_SECRET=troque-por-um-valor-aleatorio
PORT=5000
